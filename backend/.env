# SEHAT AI v2.0 — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════
# Copy this file and fill in your values
# The app works without all keys - see notes below

PORT=5000
NODE_ENV=development

# ─── DATABASE ──────────────────────────────────────────
# Get FREE at: mongodb.com/atlas → Create M0 cluster
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.xxx.mongodb.net/sehatai
MONGODB_URI=mongodb://atlas-sql-69e79942d686d82707e22ece-4jxkog.a.query.mongodb.net/sehatai?ssl=true&authSource=admin
# ─── JWT SECURITY ──────────────────────────────────────
JWT_SECRET=sehatai_jwt_2024_change_this_in_production
JWT_REFRESH_SECRET=sehatai_refresh_2024_change_this
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d

# ─── AI APIS (Add keys one by one as you get them) ─────

# GEMINI — PRIMARY AI (Your student subscription)
# Get at: aistudio.google.com → Get API Key (FREE with student account)
GEMINI_API_KEY=AIzaSyCH_zcAwvCAE6PSv2Wpm1QKXBweht7EhR0
GEMINI_MODEL=gemini-1.5-pro

# OPENAI / ChatGPT — SECONDARY
# Get at: platform.openai.com → API Keys (Free tier: $5 credit)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# DEEPSEEK — TERTIARY (Very cheap, excellent for medical)
# Get at: platform.deepseek.com → API Keys (Free credits on signup)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# QWEN — QUATERNARY (Alibaba Cloud, free tier available)
# Get at: dashscope.aliyuncs.com → API Keys
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# ─── AI FALLBACK ORDER ─────────────────────────────────
# System tries APIs in this order:
# 1. Gemini (your primary)
# 2. OpenAI GPT
# 3. DeepSeek
# 4. Qwen
# 5. Smart offline response (always works)
AI_FALLBACK_ORDER=gemini,openai,deepseek,qwen

